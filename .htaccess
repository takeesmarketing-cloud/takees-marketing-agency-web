# ============================================================
#  Takees Marketing — Hostinger Shared Hosting Configuration
#  Place this file in public_html/ (project root)
# ============================================================

# ----------------------------------------------------------
#  Charset & MIME Types
# ----------------------------------------------------------
AddDefaultCharset UTF-8

# ----------------------------------------------------------
#  Home Page
#  Only index.html is used as a folder's home page (no PHP)
# ----------------------------------------------------------
DirectoryIndex index.html

AddType image/svg+xml .svg
AddType image/webp    .webp
AddType font/woff2    .woff2
AddType font/woff     .woff

# ----------------------------------------------------------
#  Server Page Cache (LiteSpeed)
#  The site is plain HTML, so the server page cache left over from
#  the old WordPress site is switched off; it kept serving the old
#  WordPress home page
# ----------------------------------------------------------
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# ----------------------------------------------------------
#  Compression (Gzip)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------
#  Browser Caching
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — always checked with the server, so a new deploy shows at once
  ExpiresByType text/html                 "access plus 0 seconds"

  # CSS & JS — medium cache
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"

  # Images — long cache
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ----------------------------------------------------------
#  Clean Addresses
#  Every page is served without .html: takees.in/, /about,
#  /services, /bangalore … (no trailing slash, so each page's
#  relative css/js/asset paths resolve to the root)
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Visiting /index.html directly → the home address takees.in/
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^ / [R=301,L]

  # Old folder addresses: /bangalore/ and /bangalore/index.html → /bangalore
  RewriteRule ^(bangalore|kochi)/(index\.html)?$ /$1 [R=301,L]

  # The Method page was removed → About Us (its "How We Work" section)
  RewriteRule ^(?:(?:bangalore|kochi)/)?method\.html$ /about [R=301,L]

  # Old folder pages (/bangalore/about.html …) → the shared page
  RewriteRule ^(?:bangalore|kochi)/([a-z-]+)\.html$ /$1 [R=301,L]

  # Addresses from the previous takees.in site → the matching page
  RewriteRule ^about-takees-marketing/?$ /about [R=301,L]
  RewriteRule ^digital-marketing-services/?$ /services [R=301,L]
  RewriteRule ^digital-marketing-company-achievements/?$ /achievements [R=301,L]
  RewriteRule ^contact-takees-marketing-company/?$ /contact [R=301,L]
  RewriteRule ^best-digital-marketing-agency-in-bangalore/?$ /blog-details [R=301,L]

  # Visiting /about.html directly → /about
  RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # A trailing slash on a page address → without it (/blogs/ → /blogs)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z-]+)/$ /$1 [R=301,L]

  # Serve the clean address from its .html file
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z-]+)$ /$1.html [L]
</IfModule>

# ----------------------------------------------------------
#  Custom 404 Error Page
# ----------------------------------------------------------
# ErrorDocument 404 /404.html

# ----------------------------------------------------------
#  Security Headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
  # Pages must not be served from an old cached copy (browser, CDN or server)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Basic XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------
#  Prevent access to hidden/dot files
# ----------------------------------------------------------
<FilesMatch "^\\.">
  Order allow,deny
  Deny from all
</FilesMatch>
