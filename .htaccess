# ============================================================
#  Takees Marketing — Hostinger Shared Hosting Configuration
#  Place this file in public_html/ (project root)
# ============================================================

# ----------------------------------------------------------
#  Charset & MIME Types
# ----------------------------------------------------------
AddDefaultCharset UTF-8

# ----------------------------------------------------------
#  Home Page
#  Only index.html is used as a folder's home page (no PHP)
# ----------------------------------------------------------
DirectoryIndex index.html

AddType image/svg+xml .svg
AddType image/webp    .webp
AddType font/woff2    .woff2
AddType font/woff     .woff

# ----------------------------------------------------------
#  Server Page Cache (LiteSpeed)
#  The site is plain HTML, so the server page cache left over from
#  the old WordPress site is switched off; it kept serving the old
#  WordPress home page
# ----------------------------------------------------------
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# ----------------------------------------------------------
#  Compression (Gzip)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------
#  Browser Caching
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — always checked with the server, so a new deploy shows at once
  ExpiresByType text/html                 "access plus 0 seconds"

  # CSS & JS — medium cache
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"

  # Images — long cache
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ----------------------------------------------------------
#  Clean Addresses
#  Every page is served without .html: takees.in/, /about,
#  /services, /bangalore … (no trailing slash, so each page's
#  relative css/js/asset paths resolve to the root)
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Visiting /index.html directly → the home address takees.in/
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^ / [R=301,L]

  # Old folder addresses: /bangalore/ and /bangalore/index.html → /bangalore
  RewriteRule ^(bangalore|kochi)/(index\.html)?$ /$1 [R=301,L]

  # The Method page was removed → About Us (its "How We Work" section)
  RewriteRule ^(?:(?:bangalore|kochi)/)?method\.html$ /about [R=301,L]

  # Old folder pages (/bangalore/about.html …) → the shared page
  RewriteRule ^(?:bangalore|kochi)/([a-z-]+)\.html$ /$1 [R=301,L]

  # Addresses from the previous takees.in (WordPress) site → the matching page
  RewriteRule ^(about-takees-marketing|about-takees-digital-marketing-agency-in-kannur-kerala|about-takees-marketing-in-kannur-kerala)/?$ /about [R=301,L]
  RewriteRule ^(digital-marketing-services|services-of-takees-marketing-agency-kannur-kerala)/?$ /services [R=301,L]
  RewriteRule ^(digital-marketing-company-achievements|portfolio2?|vastragni-branding|wgl-2|branding-v)/?$ /achievements [R=301,L]
  RewriteRule ^(contact-takees-marketing-company|contact-page-of-best-digital-marketing-agency-in-kannur)/?$ /contact [R=301,L]
  RewriteRule ^best-digital-marketing-agency-in-bangalore/?$ /blog-details [R=301,L]
  RewriteRule ^(best-digital-marketing-company-in-bangalore(-takees)?|digital-marketing-company-in-bangalore|social-media-marketing-in-bangalore|website-developer-in-bangalore)/?$ /bangalore [R=301,L]
  RewriteRule ^(digital-marketing-company-in-kannur|website-developer-in-kannur|social-media-marketing-for-small-businesses-in-kannur)/?$ / [R=301,L]
  RewriteRule ^(latest-ai-tools-for-marketers-to-use-not-to-miss-it|best-ai-tools-of-2026)/?$ /ai-tools [R=301,L]
  RewriteRule ^co-working-space-in-kannur-takees-park-kannur/?$ https://takeescowork.com/ [R=301,L]

  # Blog articles: each one is a page in /articles, shown at /blogs/<article>
  RewriteCond %{THE_REQUEST} \s/+articles/([a-z0-9-]+)\.html[\s?]
  RewriteRule ^ /blogs/%1 [R=301,L]
  RewriteRule ^blogs/([a-z0-9-]+)/$ /blogs/$1 [R=301,L]
  RewriteRule ^blogs/([a-z0-9-]+)$ /articles/$1.html [L]

  # Old article addresses (WordPress site) → the article's page
  RewriteRule ^good-news-for-jio-users-to-get-gemini-pro-for-free/?$ /blogs/gemini-pro-for-jio-users [R=301,L]
  RewriteRule ^how-does-instagram-search-engine-work-guide/?$ /blogs/how-instagram-search-works [R=301,L]
  RewriteRule ^how-long-does-digital-marketing-take-to-show-results/?$ /blogs/digital-marketing-results-timeline [R=301,L]
  RewriteRule ^how-to-build-a-brand-through-social-media-simple-guide/?$ /blogs/build-brand-through-social-media [R=301,L]
  RewriteRule ^how-to-start-business-from-zero-a-practical-guide/?$ /blogs/how-to-start-business-from-zero [R=301,L]
  RewriteRule ^purple-cow-theory-what-it-means/?$ /blogs/purple-cow-marketing [R=301,L]
  RewriteRule ^what-is-70-20-10-rule-in-digital-marketing/?$ /blogs/70-20-10-rule-digital-marketing [R=301,L]
  RewriteRule ^(instagram-carousel-captions|instagram-instants|latest-instagram-updates|meta-ads-new-targeting-update)/?$ /blogs/$1 [R=301,L]

  # Visiting /about.html directly → /about
  RewriteCond %{THE_REQUEST} \s/+([a-z-]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # A trailing slash on a page address → without it (/blogs/ → /blogs)
  RewriteRule ^(about|services|achievements|blogs|blog-details|ai-tools|contact|bangalore|kochi)/$ /$1 [R=301,L]

  # Any other old WordPress address (blog posts, categories; they all end with
  # a slash) → the Blogs page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+/)$ /blogs [R=301,L]

  # Serve the clean address from its .html file
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z-]+)$ /$1.html [L]
</IfModule>

# ----------------------------------------------------------
#  Custom 404 Error Page
# ----------------------------------------------------------
# ErrorDocument 404 /404.html

# ----------------------------------------------------------
#  Security Headers
# ----------------------------------------------------------
<IfModule mod_headers.c>
  # Pages must not be served from an old cached copy (browser, CDN or server)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Basic XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------
#  Prevent access to hidden/dot files
# ----------------------------------------------------------
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# ----------------------------------------------------------
#  Development Files
#  The repository also holds tools that are not part of the
#  website (local server, scripts, editor and AI settings);
#  answer "not found" for them and for dot-folders
#  (/.well-known stays open: it is used to renew the SSL certificate)
# ----------------------------------------------------------
RedirectMatch 404 ^/(\.(?!well-known)[^/]+|serve\.js|README\.md|[^/]+\.ps1|inspect_[a-z]+\.js|exports)(/|$)
